# ============================================================================
# RISK LENS — Backend Environment Configuration
# ============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# Option 1: Direct Supabase Connection String (Recommended)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:risklens2026@db.zzbizppiuttlpaawldqh.supabase.co:5432/postgres

# Option 2: Discrete Supabase Connection Parameters
PGHOST=aws-0-[REGION].pooler.supabase.com
PGPORT=6543
PGUSER=postgres.[PROJECT_REF]
PGPASSWORD=your_supabase_db_password_here
PGDATABASE=postgres
PGSSL=true

# ----------------------------------------------------------------------------
# SUPABASE API (Optional for direct REST / Auth integrations)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ----------------------------------------------------------------------------
# RISK ENGINE & AGENT SETTINGS
# ----------------------------------------------------------------------------
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MODERATE=60
RISK_THRESHOLD_HIGH=80
AI_AUTONOMOUS_MODE=false
DEBUG_SQL=false
