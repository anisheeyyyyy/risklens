# ============================================================================
# RISK LENS - Environment Variables Configuration
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Or discrete parameters:
PGHOST=aws-0-[REGION].pooler.supabase.com
PGPORT=6543
PGUSER=postgres.[PROJECT_REF]
PGPASSWORD=your_supabase_db_password_here
PGDATABASE=postgres
PGSSL=true

# Supabase API credentials
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Risk Engine Thresholds (0-100 scale)
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MODERATE=60
RISK_THRESHOLD_HIGH=80

# AI Layer & Orchestration Settings
AI_AUTONOMOUS_MODE=false
AI_ANALYSIS_INTERVAL_MS=300000
DEBUG_SQL=false
